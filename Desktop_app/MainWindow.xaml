<Window x:Class="StoryboxSdPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:StoryboxSdPrep.Converters"
        mc:Ignorable="d"
        Title="Storybox SD Prep"
        Width="1240"
        Height="760"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fisier">
                <MenuItem Header="Adauga MP3..." Click="AddMp3MenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Prepare SD Card" Click="PrepareSdCardMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Iesire" Click="ExitMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="Prepare SD Card" Click="PrepareSdCardMenuItem_OnClick" />
        </Menu>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Povesti" Margin="0,0,10,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="Adauga MP3..."
                                Width="120"
                                Margin="0,0,8,0"
                                Click="AddMp3MenuItem_OnClick" />
                        <Button Content="Comaseaza selectia"
                                Width="135"
                                Margin="0,0,8,0"
                                Click="MergeStoriesMenuItem_OnClick" />
                        <Button Content="Sterge selectia"
                                Width="110"
                                Click="DeleteStoriesMenuItem_OnClick" />
                    </StackPanel>

                    <ListView x:Name="StoriesListBox"
                              MinHeight="420"
                              SelectionMode="Extended"
                              ItemsSource="{Binding Stories}"
                              SelectedItem="{Binding SelectedStory, Mode=TwoWay}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="" Width="36">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Canvas Width="16"
                                                    Height="14"
                                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Rectangle Width="16"
                                                           Height="14"
                                                           Stroke="#2E7D32"
                                                           Fill="#DDF4E2"
                                                           RadiusX="2"
                                                           RadiusY="2" />
                                                <Polygon Fill="#2E7D32"
                                                         Points="1,11 5,7 8,10 11,6 15,11 15,13 1,13" />
                                                <Ellipse Width="3"
                                                         Height="3"
                                                         Fill="#2E7D32"
                                                         Canvas.Left="10"
                                                         Canvas.Top="2" />
                                            </Canvas>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Poveste"
                                                Width="270"
                                                DisplayMemberBinding="{Binding Title}" />
                                <GridViewColumn Header="Length"
                                                Width="80"
                                                DisplayMemberBinding="{Binding TrackLengthDisplay}" />
                                <GridViewColumn Header="Bitrate"
                                                Width="95"
                                                DisplayMemberBinding="{Binding BitrateDisplay}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu Opened="StoriesContextMenu_OnOpened">
                                <MenuItem x:Name="MergeStoriesContextMenuItem"
                                          Header="Comaseaza selectia in poveste noua"
                                          Click="MergeStoriesMenuItem_OnClick" />
                                <MenuItem Header="Sterge selectia"
                                          Click="DeleteStoriesMenuItem_OnClick" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <Grid Grid.Column="1"
                  DataContext="{Binding SelectedStory}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Titlu poveste"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Width="420"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0"
                              Header="Capitole"
                              Margin="0,0,10,0">
                        <DataGrid ItemsSource="{Binding Chapters}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Width="45"
                                                    IsReadOnly="True"
                                                    Binding="{Binding DisplayOrder}" />
                                <DataGridTextColumn Header="Track"
                                                    Width="60"
                                                    IsReadOnly="True"
                                                    Binding="{Binding TrackNumber}" />
                                <DataGridTextColumn Header="Length"
                                                    Width="70"
                                                    IsReadOnly="True"
                                                    Binding="{Binding DurationDisplay}" />
                                <DataGridTextColumn Header="Bitrate"
                                                    Width="80"
                                                    IsReadOnly="True"
                                                    Binding="{Binding BitrateDisplay}" />
                                <DataGridTextColumn Header="Titlu capitol"
                                                    Width="220"
                                                    Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Fisier sursa"
                                                    Width="*"
                                                    IsReadOnly="True"
                                                    Binding="{Binding SourcePath}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Cover (PNG 400x400)">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,10">
                                <Button Content="Alege poza..."
                                        Width="100"
                                        Margin="0,0,8,0"
                                        Click="PickCoverButton_OnClick" />
                                <Button Content="Paste"
                                        Width="80"
                                        Margin="0,0,8,0"
                                        Click="PasteCoverButton_OnClick" />
                                <Button Content="Sterge"
                                        Width="80"
                                        Click="ClearCoverButton_OnClick" />
                            </StackPanel>

                            <Border BorderBrush="#A0A0A0"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="280">
                                <Grid>
                                    <Image Source="{Binding CoverPreview}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                    <TextBlock Text="Fara cover"
                                               Foreground="#707070"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding CoverPreview, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                                </Grid>
                            </Border>
                        </DockPanel>
                    </GroupBox>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="#D6D6D6"
                        BorderThickness="1"
                        Padding="10"
                        CornerRadius="4"
                        Background="#FAFAFA">
                    <StackPanel>
                        <TextBlock Text="Reguli active:" FontWeight="SemiBold" />
                        <TextBlock Text="- Import MP3: fiecare fisier devine o poveste cu un capitol." />
                        <TextBlock Text="- Comasare: creeaza o poveste noua, sterge povestile selectate." />
                        <TextBlock Text="- Ordine capitole: Track ID3 crescator, apoi alfabetic." />
                        <TextBlock Text="- Cover: se salveaza automat ca PNG 400x400 (cover.png)." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
