<Window x:Class="StoryboxSdPrep.PrepareSdCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:StoryboxSdPrep.Converters"
        mc:Ignorable="d"
        Title="Prepare SD Card"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="1) Selecteaza drive-ul SD" Margin="0,0,0,10">
            <DockPanel LastChildFill="True" Margin="4">
                <Button DockPanel.Dock="Right"
                        Width="90"
                        Margin="8,0,0,0"
                        Content="Refresh"
                        Click="RefreshDrivesButton_OnClick" />
                <ComboBox ItemsSource="{Binding Drives}"
                          SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          MinWidth="420"
                          IsEditable="False" />
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="2) Optiuni formatare" Margin="0,0,0,10">
            <StackPanel Margin="8">
                <CheckBox Content="Formateaza cardul in FAT32 inainte de copiere"
                          IsChecked="{Binding FormatFat32, Mode=TwoWay}" />

                <Grid Margin="0,8,0,0"
                      Visibility="{Binding FormatFat32, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Fat32ToolPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Content="Alege utilitar..."
                            Margin="8,0,0,0"
                            Padding="12,4"
                            Click="PickFat32ToolButton_OnClick" />
                </Grid>

                <TextBlock Margin="0,8,0,0"
                           Foreground="#666"
                           TextWrapping="Wrap"
                           Text="Utilitar recomandat: fat32format.exe. Va fi apelat automat cu litera drive-ului selectat (ex: E:)." />
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="2"
                BorderBrush="#D5D5D5"
                BorderThickness="1"
                CornerRadius="4"
                Background="#FAFAFA"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="3) Ce face procesul" FontWeight="SemiBold" />
                <TextBlock Text="- Creeaza cate un folder per poveste pe SD." />
                <TextBlock Text="- Copiaza capitolele ca 01 - Titlu.mp3, 02 - Titlu.mp3..." />
                <TextBlock Text="- Copiaza cover-ul ca cover.png (daca exista)." />
                <TextBlock Text="- Daca folderul povestii exista deja, este suprascris." />
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="3" Header="Povesti de exportat">
            <ListBox ItemsSource="{Binding StoryTitles}" />
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#666"
                       Text="{Binding StatusMessage}" />

            <Button DockPanel.Dock="Right"
                    Width="90"
                    Margin="8,0,0,0"
                    Content="Inchide"
                    Click="CloseButton_OnClick" />

            <Button DockPanel.Dock="Right"
                    Width="150"
                    Content="Prepare SD Card"
                    IsEnabled="{Binding CanPrepare}"
                    Click="PrepareButton_OnClick" />
        </DockPanel>
    </Grid>
</Window>
